# Reference template — the QA pipeline builds the Secret in code to avoid base64/YAML quoting issues.
# See agents.md: .dockerconfigjson in data must be base64 of the pull config.
apiVersion: v1
kind: Secret
metadata:
  name: __OCI_SECRET_NAME__
  namespace: model-validation
  annotations:
    registry.host/openshift: "__REGISTRY_HOST__"
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: "__DOCKERCONFIGJSON_B64__"
